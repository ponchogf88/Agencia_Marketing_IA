# ==============================================================================
# PROMPT AGENT ENVIRONMENT CONFIGURATION (.ENV.EXAMPLE)
# Copy this file to .env and fill in your credentials
# ==============================================================================

# 1. CORE AI INFERENCE (MANDATORY)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# 2. KNOWLEDGE BASES (OPTIONAL)
NOTION_API_TOKEN="your_notion_internal_integration_secret"
NOTION_DATABASE_ID="your_notion_database_id"
OBSIDIAN_VAULT_PATH="C:/Users/USUARIO/Documents/ObsidianVault"

# 3. NOTIFICATIONS & 1-CLICK APPROVAL
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# 4. CREATIVE & VIDEO ASSETS (PHASE 2)
ELEVENLABS_API_KEY=""
KLING_API_KEY=""
RUNWAY_API_KEY=""

# 5. MULTICHANNEL PUBLISHING (PHASE 3)
LINKEDIN_ACCESS_TOKEN=""
X_API_BEARER_TOKEN=""
META_GRAPH_ACCESS_TOKEN=""
